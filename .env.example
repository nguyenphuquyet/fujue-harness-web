# Đường dẫn file SQLite. Mặc định: <thư mục dự án>/data/fujue.db
FUJUE_DB_PATH=

# Địa chỉ công khai của site, dùng cho liên kết trong email và app desktop.
NEXT_PUBLIC_SITE_URL=http://localhost:4310

# API base mà harness nhận từ GET /api/v1/harness/config. Để trống thì harness gọi
# thẳng cổng model của chính site: <origin>/api/v1. Chỉ đặt khi tách cổng model ra
# một miền riêng.
FUJUE_GATEWAY_URL=

# Nguồn model khởi tạo cho lần chạy đầu tiên, khi cơ sở dữ liệu còn rỗng. Cổng
# `/api/v1/chat/completions` chuyển tiếp lời gọi sang URL này, nên đừng trỏ về chính
# site. Mặc định: https://api.deepseek.com/v1
FUJUE_SEED_PROVIDER_URL=

# Tài khoản quản trị đầu tiên, chỉ dùng khi cơ sở dữ liệu còn rỗng.
FUJUE_ADMIN_EMAIL=admin@fujue.dev
FUJUE_ADMIN_PASSWORD=

# Dữ liệu mẫu: hai người dùng demo, khoá giả, thống kê và nhật ký. Đặt 0 khi chạy
# công khai để cơ sở dữ liệu chỉ có tài khoản quản trị. Mặc định: 1
FUJUE_SEED_DEMO=1
